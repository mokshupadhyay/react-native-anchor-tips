{
  "name": "react-native-anchor-tips",
  "version": "0.1.0-beta.0",
  "description": "Tooltips, tips and guided tours anchored to any view in React Native: smart placement, arrows, spotlight, show-once rules, and an optional native overlay that works on the old and new architecture.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "author": "Moksh Upadhyay <mokshupadhyay4@gmail.com>",
  "homepage": "https://github.com/mokshupadhyay/react-native-anchor-tips#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokshupadhyay/react-native-anchor-tips.git"
  },
  "bugs": {
    "url": "https://github.com/mokshupadhyay/react-native-anchor-tips/issues"
  },
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/src",
    "ios",
    "react-native-anchor-tips.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test && npm run build",
    "example:install": "npm pack --pack-destination example && cd example && npm install ./react-native-anchor-tips-$npm_package_version.tgz",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "tooltip",
    "tip",
    "tipkit",
    "popover",
    "coachmark",
    "onboarding",
    "tour",
    "spotlight",
    "turbo-module",
    "new-architecture"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "codegenConfig": {
    "name": "RNAnchorTipsSpec",
    "type": "modules",
    "jsSrcsDir": "src/native/specs",
    "android": {
      "javaPackageName": "com.anchortips"
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
